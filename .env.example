# Copia como .env. No pegues claves en el frontend ni en Git.
APP_PORT=8787
APP_USER=dev
APP_PASSWORD=campo-demo-2026
USER_RESPONSIBLE_MAP=
# Ejemplo: {"abner":{"employeeNumber":"AGROKOOL-0003","assignmentId":"cmuekzthi000awansffv8mjzl","name":"Abner Perz"}}
ENFORCE_RESPONSIBLE_ACCESS=false
ERP_MODE=demo
# Para datos reales: ERP_MODE=live, URL HTTPS con sufijo /api y clave propia.
ERP_API_URL=
ERP_API_KEY=
TELEGRAM_MODE=demo
TELEGRAM_POLLING=true
# live publica reportes reales en el grupo configurado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# IDs numericos separados por coma; solo estos usuarios pueden entrar via Telegram.
TELEGRAM_ALLOWED_USERS=
# URL HTTPS publica de esta app (para enlaces de los reportes).
PUBLIC_URL=
APP_DOMAIN=
# true si se sirve detras de un proxy HTTPS.
COOKIE_SECURE=false

# Desactivar cuando la Mini App pública use identidad Telegram
PASSWORD_LOGIN_ENABLED=true

# Solo para un ERP de pruebas que no disponga de HTTPS
ERP_ALLOW_HTTP=false
# Volumen independiente al cambiar de demo a ERP real
# CAMPO_DATA_VOLUME=campo-telegram_erp-live-data
